# Shell scripts, units and config that run on the Pi must stay LF regardless of the dev box.
* text=auto
*.sh text eol=lf
*.service text eol=lf
*.timer text eol=lf
Caddyfile text eol=lf
Dockerfile text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.py text eol=lf
*.md text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.png binary
*.jpg binary
*.ico binary
