# Copy to /opt/health/.env on the Pi, chmod 600, never commit. Created by hand once.

# --- app (read by the api container) ---
GEMINI_API_KEY=                       # optional until photo/text logging; Google AI Studio, restrict to the Generative Language API
GEMINI_MODEL=gemini-2.5-flash         # check the live model list at ai.google.dev before first deploy
API_BEARER_TOKEN=                     # openssl rand -hex 32  (>= 32 chars)
TZ=Europe/Madrid
LOG_LEVEL=INFO

# --- deploy (read by docker compose, bootstrap.sh and the timers) ---
GHCR_IMAGE=ghcr.io/<github-user>/<repo>   # lower-case; the workflow publishes :latest and :<sha> here
TS_HOSTNAME=health.<tailnet>.ts.net       # MagicDNS name of the Pi; Caddy gets its cert from tailscaled
HEALTH_DATA_DIR=/mnt/storage/health       # attached storage, never the SD card; mounted at /data in the container
# PUID / PGID / BIND_IP / DOCKER_CONFIG_DIR are filled in by bootstrap.sh if missing
# BIND_IP=100.x.y.z                        # optional: bind Caddy to the Tailscale IP only (invisible on the LAN)
# OFFSITE_REMOTE=                          # optional: rclone remote for the weekly backup sync, e.g. b2:bucket/health
